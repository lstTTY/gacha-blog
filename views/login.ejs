<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="msvalidate.01" content="F836059B67B11AF7B6B0D4BDF777C658" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
    <link rel="apple-touch-icon" href="/favicon-180.png">
    <title>登录 - 似意抽卡</title>
    <meta name="description" content="登录似意抽卡，在线免费抽卡游戏。">
    <link rel="stylesheet" href="/style.css?v=31">
</head>
<body>
    <div class="container">
        <h1>似意抽卡</h1>
        <p class="subtitle">登录你的账号开始抽卡</p>

        <!-- 注册成功提示 -->
        <% if (registered) { %>
            <div class="flash success">注册成功！请登录</div>
        <% } %>

        <!-- 封号提示 -->
        <% if (banned) { %>
            <div class="flash error">此账号已被封禁，无法登录</div>
        <% } %>

        <!-- 错误信息 -->
        <% if (error) { %>
            <div class="flash error"><%= error %></div>
        <% } %>

        <!-- 登录表单 -->
        <form method="POST" action="/login">
            <div class="field">
                <label>用户名</label>
                <input 
                    type="text" 
                    name="username" 
                    placeholder="输入用户名" 
                    required 
                    autofocus
                >
            </div>
            <div class="field">
                <label>密码</label>
                <input 
                    type="password" 
                    name="password" 
                    placeholder="输入密码" 
                    required
                >
            </div>
            <button type="submit" class="btn">登录</button>
        </form>

        <div class="link-container">
            <a href="/register" class="link">没有账号？去注册</a>
        </div>

        <p class="footer">&copy; 2026 似意抽卡</p>
    </div>
</body>
</html>
