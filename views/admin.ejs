<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="msvalidate.01" content="F836059B67B11AF7B6B0D4BDF777C658" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
    <link rel="apple-touch-icon" href="/favicon-180.png">
    <title>管理面板 - 似意抽卡</title>
    <link rel="stylesheet" href="/style.css?v=31">
    <style>
        .admin-container {
            max-width: 900px;
            margin: 80px auto 20px;
            padding: 20px;
        }
        .admin-title {
            color: #f59e0b;
            font-size: 22px;
            margin-bottom: 20px;
            text-align: center;
        }
        .user-card {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 14px;
            transition: background 0.2s;
        }
        .user-card:hover {
            background: rgba(255, 255, 255, 0.1);
        }
        .user-card.banned {
            border-color: rgba(255, 68, 68, 0.3);
            opacity: 0.6;
        }
        .user-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.2);
            object-fit: cover;
            flex-shrink: 0;
        }
        .user-info {
            flex: 1;
            min-width: 0;
        }
        .user-name {
            font-weight: 700;
            color: #fff;
            font-size: 15px;
        }
        .user-name .admin-badge {
            background: rgba(245, 158, 11, 0.15);
            color: #f59e0b;
            border: 1px solid #f59e0b;
            border-radius: 4px;
            padding: 1px 6px;
            font-size: 11px;
            margin-left: 6px;
        }
        .user-name .banned-badge {
            background: rgba(255, 68, 68, 0.15);
            color: #ff4444;
            border: 1px solid #ff4444;
            border-radius: 4px;
            padding: 1px 6px;
            font-size: 11px;
            margin-left: 6px;
        }
        .user-meta {
            font-size: 12px;
            color: #888;
            margin-top: 3px;
        }
        .user-pulls {
            font-size: 12px;
            color: #809f9f;
            margin-top: 3px;
        }
        .user-actions {
            flex-shrink: 0;
        }
        .btn-ban {
            background: rgba(255, 68, 68, 0.15);
            color: #ff4444;
            border: 1px solid #ff4444;
            border-radius: 6px;
            padding: 6px 14px;
            cursor: pointer;
            font-size: 13px;
            transition: all 0.2s;
        }
        .btn-ban:hover {
            background: rgba(255, 68, 68, 0.3);
        }
        .btn-unban {
            background: rgba(74, 222, 128, 0.15);
            color: #4ade80;
            border: 1px solid #4ade80;
            border-radius: 6px;
            padding: 6px 14px;
            cursor: pointer;
            font-size: 13px;
            transition: all 0.2s;
        }
        .btn-unban:hover {
            background: rgba(74, 222, 128, 0.3);
        }
        .empty-msg {
            text-align: center;
            color: #888;
            padding: 40px;
        }
    </style>
</head>
<body>
    <!-- 毛玻璃导航栏 -->
    <nav class="navbar">
        <a href="/gacha" class="nav-brand"><img src="/images/siyichouka.png" class="nav-logo"></a>
        <div class="nav-right">
            <% if (user.avatar) { %>
                <img src="<%= user.avatar %>" class="nav-avatar" onerror="this.style.display='none'">
            <% } %>
            <span class="nav-user"><b><%= user.username %></b> <span style="color:#f59e0b;font-size:12px;">[管理员]</span></span>
            <a href="/logout" class="nav-logout">退出</a>
        </div>
    </nav>

    <div class="admin-container">
        <h1 class="admin-title">👤 用户管理</h1>

        <% if (users.length === 0) { %>
            <p class="empty-msg">暂无用户</p>
        <% } %>

        <% users.forEach(function(u) { %>
            <div class="user-card<%= u.banned ? ' banned' : '' %>" id="user-<%= u.id %>">
                <% if (u.avatar) { %>
                    <img src="<%= u.avatar %>" class="user-avatar" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 40 40%22><rect width=%2240%22 height=%2240%22 rx=%2220%22 fill=%22%23333%22/><text x=%2220%22 y=%2226%22 text-anchor=%22middle%22 fill=%22%23666%22 font-size=%2216%22>👤</text></svg>'">
                <% } else { %>
                    <div class="user-avatar" style="background:#333;display:flex;align-items:center;justify-content:center;font-size:20px;">👤</div>
                <% } %>
                <div class="user-info">
                    <div class="user-name">
                        <%= u.username %>
                        <% if (u.is_admin) { %>
                            <span class="admin-badge">管理员</span>
                        <% } %>
                        <% if (u.banned) { %>
                            <span class="banned-badge">已封禁</span>
                        <% } %>
                    </div>
                    <div class="user-meta">
                        邮箱：<%= u.email || '未填写' %> ｜ 注册：<%= u.created_at || '未知' %>
                    </div>
                    <div class="user-pulls">抽卡次数：<%= u.total_pulls %></div>
                </div>
                <div class="user-actions">
                    <% if (!u.is_admin) { %>
                        <% if (u.banned) { %>
                            <button class="btn-unban" onclick="unbanUser(<%= u.id %>)">解封</button>
                        <% } else { %>
                            <button class="btn-ban" onclick="banUser(<%= u.id %>)">封号</button>
                        <% } %>
                    <% } %>
                </div>
            </div>
        <% }); %>
    </div>

    <script>
        async function banUser(id) {
            if (!confirm('确定要封禁此用户吗？')) return;
            const res = await fetch('/api/ban/' + id, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert(data.error);
            }
        }
        async function unbanUser(id) {
            if (!confirm('确定要解封此用户吗？')) return;
            const res = await fetch('/api/unban/' + id, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert(data.error);
            }
        }
    </script>
</body>
</html>
